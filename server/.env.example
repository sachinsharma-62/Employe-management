# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/office_management

# Auth
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false

# Apps
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Seed (initial super admin)
SEED_SUPER_ADMIN_EMAIL=superadmin@office.com
SEED_SUPER_ADMIN_PASSWORD=Super@1234

# SMTP (optional - reset links are logged to console when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Office EMS <no-reply@office.com>"
