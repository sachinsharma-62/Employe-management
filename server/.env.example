# Server
PORT=5000
NODE_ENV=development
HOST=0.0.0.0

# Database (Atlas: use MONGODB_URI; local: can use MONGO_URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/office_management?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/office_management

# Auth
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cookies (set explicitly for production; leave unset for local defaults)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Apps
# For local dev: http://localhost:3000
# For production (Vercel): comma-separated if multiple origins e.g. https://your-app.vercel.app
CLIENT_URL=http://localhost:3000
# For production: set to Render backend URL e.g. https://your-backend.onrender.com
SERVER_URL=http://localhost:5000

# Seed (initial super admin)
SEED_SUPER_ADMIN_EMAIL=superadmin@office.com
SEED_SUPER_ADMIN_PASSWORD=Super@1234

# SMTP (optional - reset links are logged to console when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Office EMS <no-reply@office.com>"

# Company (optional)
COMPANY_NAME=Office EMS Pvt. Ltd.
COMPANY_EMAIL=hr@office-ems.com
COMPANY_PHONE=+91 80 4000 0000
COMPANY_WEBSITE=www.office-ems.com
COMPANY_ADDRESS=2nd Floor, Business Park, MG Road, Bengaluru, Karnataka 560001
COMPANY_GSTIN=
COMPANY_CIN=
